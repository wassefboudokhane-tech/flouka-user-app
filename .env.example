# Copy to `.env` locally. Never commit real keys.
# Trackers stay off until the user accepts consent (FR/AR).

FLOUKA_API_BASE=
FLOUKA_SITE_URL=https://flouka.app
FLOUKA_ENV=dev

# PostHog Cloud EU — project API key, not a personal token.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Microsoft Clarity project id (Flutter SDK).
CLARITY_PROJECT_ID=

# Firebase / GA4 — leave empty to skip native init.
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
GA4_MEASUREMENT_ID=

# CTA A/B: ink (default) or violet (#35035C).
FLOUKA_CTA_VARIANT=ink

# Demo catalog only when the public API is empty.
FLOUKA_USE_DEMO_CATALOG=true
